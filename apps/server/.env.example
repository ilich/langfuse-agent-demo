# Copy this file to .env and adjust the values.

# Path to the Northwind SQLite database (relative to the project root or absolute).
NORTHWIND_DB_PATH=data/northwind.db

# The crew's "today" (ISO date). Unset = the real date. 2023-11-20 is close to the newest orders.
CURRENT_DATE=2023-11-20

# Refund policy the refund agent reads on every request.
REFUND_POLICY_PATH=docs/refund-policy.md

# CrewAI model for all agents.
LLM_MODEL=openai/gpt-4o-mini

# OpenAI API key; required to run the crew, not to start the app.
OPENAI_API_KEY=

# Print each agent step, delegation and tool call to the console (CrewAI verbose mode).
CREW_VERBOSE=true

# Langfuse API keys
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Langfuse AI Gateway (https://langfuse.com/docs/gateway). When host and key are set, all model
# calls go through the gateway (OpenAI-compatible), which holds the provider key and records
# each call; OPENAI_API_KEY and LLM_MODEL are then not used. Hosts: https://gateway.cloud.langfuse.com
# (EU), https://gateway.us.cloud.langfuse.com (US), https://gateway.jp.cloud.langfuse.com (JP).
LANGFUSE_GATEWAY_HOST=
LANGFUSE_GATEWAY_KEY=
# Gateway model ID "<connection>:<model>", as listed by GET <host>/openai/v1/models.
LANGFUSE_GATEWAY_MODEL=google-ai-studio:gemini-2.5-flash
