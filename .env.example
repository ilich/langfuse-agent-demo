# Copy this file to .env and adjust the values.

# Path to the Northwind SQLite database (relative to the project root or absolute).
NORTHWIND_DB_PATH=data/northwind.db

# The crew's "today" (ISO date). Unset = the real date. 2023-11-20 is close to the newest orders.
CURRENT_DATE=2023-11-20

# Refund policy the refund agent reads on every request.
REFUND_POLICY_PATH=docs/refund-policy.md

# CrewAI model for all agents (Gemini).
LLM_MODEL=gemini/gemini-2.5-flash

# Gemini API key; required to run the crew, not to start the app.
GEMINI_API_KEY=

# Print each agent step, delegation and tool call to the console (CrewAI verbose mode).
CREW_VERBOSE=true
